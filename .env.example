# Claude Code WebUI — environment variables (template).
# Copy to .env and fill in values, or run ./scripts/install.sh which writes
# this for you interactively. .env is gitignored.

# --- Hosting ---------------------------------------------------------------
# Host port the WebUI is exposed on (container always listens on 3001 internally)
WEBUI_PORT=4545
# Public URL used in OAuth redirects + CORS allowlist seed
FRONTEND_URL=http://localhost:4545
# Comma-separated additional CORS origins (FRONTEND_URL is always allowed)
CORS_ALLOWED_ORIGINS=http://localhost:4545

# --- Auth ----------------------------------------------------------------
# REQUIRED. Min 32 chars each. Generate with: openssl rand -base64 48
SESSION_SECRET=
JWT_SECRET=

# Comma-separated email allowlist. Only these emails can sign in via OAuth or
# basic-auth. Leave EMPTY only if the WebUI sits behind a private network or
# an SSO proxy you trust — an empty allowlist + public URL is open signup.
AUTH_ALLOWED_EMAILS=

# First-time admin bootstrap. The user with this email gets role='admin' on
# their first login. Defaults to the first AUTH_ALLOWED_EMAILS entry if unset.
SEED_ADMIN_EMAIL=

# --- Volumes (host paths the compose file binds to) ----------------------
# Relative paths resolve against the docker compose project dir.
DATA_DIR=./data
CONFIG_DIR=./config
WORKSPACE_DIR=./workspace

# --- Optional OAuth providers --------------------------------------------
# Leave empty to disable that provider. Configure callback URLs in the
# provider dashboard to match: ${FRONTEND_URL}/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Optional CLI provider tuning ----------------------------------------
# Override the model menus shown in the WebUI per provider. Leave empty to
# auto-discover from the installed CLI.
CLI_PROVIDER_CLAUDE_MODELS=opus,sonnet,haiku
CLI_PROVIDER_CODEX_MODELS=
CLI_PROVIDER_OPENCODE_MODELS=
CLI_PROVIDER_OPENCODE_DEFAULT_MODEL=z-ai/glm-5.1

# Additional workspace base paths the in-container CLI is allowed to access.
# Defaults to /workspace (the volume above). Comma-separated.
ALLOWED_BASE_PATHS=/workspace

# --- Optional preview subdomain ------------------------------------------
# If set, dev servers spawned in /workspace get proxied at this hostname.
# PREVIEW_HOSTNAME=preview.example.com
