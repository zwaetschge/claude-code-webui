<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification icon for Claude Code WebUI (24dp, white/transparent only).
  Android requires notification icons to be single-color (white) on transparent.
  Design: simplified "C" arc matching the launcher icon aesthetic.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Open "C" arc — stroke style, white -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M17,7 A8,8 0 1 0 17,17" />

    <!-- Cursor dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18,12 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

</vector>
