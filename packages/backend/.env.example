# Server
PORT=3001
NODE_ENV=development

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# JWT Secret (generate a random string)
JWT_SECRET=your-jwt-secret-here

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Encryption Key for API Keys (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Allowed base paths for working directories (comma-separated)
ALLOWED_BASE_PATHS=/home,/Users

# CLI auto-update
CLI_AUTO_UPDATE=false
CLI_AUTO_UPDATE_INTERVAL_HOURS=0
CLI_AUTO_UPDATE_PROVIDERS=claude,codex,gemini,glm

# GLM/Claude Code split config
CLI_PROVIDER_GLM_PREFIX=/home/node/.npm-glm
CLI_PROVIDER_GLM_COMMAND=/home/node/.npm-glm/bin/claude
CLI_PROVIDER_GLM_CREDENTIALS_PATH=/home/node/.glm
WEBUI_GLM_CONFIG_HOME=/home/node/.glm
